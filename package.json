{
  "name": "workbench-kit",
  "version": "0.3.0",
  "private": true,
  "description": "여러 데스크톱 앱이 공유하는 공통 껍데기 한 벌",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start:electron": "electron src/hosts/electron/main.cjs",
    "start:pywebview": "python -m src.hosts.pywebview.main",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:open-modes": "electron scripts/verify-open-modes-electron.cjs",
    "verify:rowlist": "electron scripts/verify-rowlist-electron.cjs",
    "verify:file-filter": "electron scripts/verify-file-filter-electron.cjs",
    "verify:edit-menu": "electron scripts/verify-edit-menu-electron.cjs",
    "verify:explorer-fileops": "electron scripts/verify-explorer-fileops-electron.cjs",
    "verify:text-open": "electron scripts/verify-text-open-electron.cjs",
    "verify:word-wrap": "electron scripts/verify-word-wrap-electron.cjs",
    "verify:terminal-host": "electron scripts/verify-terminal-host-electron.cjs",
    "verify:terminal-renderer": "electron scripts/verify-terminal-renderer-electron.cjs",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "verify:phase3": "node scripts/verify-phase3.mjs",
    "verify:phase4": "node scripts/verify-phase4.mjs",
    "verify:phase5": "node scripts/verify-phase5.mjs",
    "verify:phase6": "node scripts/verify-phase6.mjs",
    "verify:phase7": "node scripts/verify-phase7.mjs",
    "test": "npm run typecheck && npm run verify:dist && npm run verify:phase2 && npm run verify:phase3 && npm run verify:phase4 && npm run verify:phase5 && npm run verify:phase6 && npm run verify:phase7 && npm run verify:v02-phase1 && npm run verify:v02-phase2 && npm run verify:v02-phase3 && npm run verify:v02-phase4 && npm run verify:v02-phase5 && npm run verify:v02-phase6 && npm run verify:v02-phase7 && npm run verify:v03-phase1 && npm run verify:v03-phase2 && npm run verify:v03-phase3 && npm run verify:v04-phase4 && npm run verify:v05-phase5 && npm run verify:v06-phase6",
    "verify:v02-phase1": "node scripts/verify-v02-phase1.mjs",
    "verify:v02-phase2": "node scripts/verify-v02-phase2.mjs",
    "verify:v02-phase3": "node scripts/verify-v02-phase3.mjs",
    "verify:v02-phase4": "node scripts/verify-v02-phase4.mjs",
    "verify:v02-phase5": "node scripts/verify-v02-phase5.mjs",
    "verify:v02-phase6": "node scripts/verify-v02-phase6.mjs",
    "verify:v02-phase7": "node scripts/verify-v02-phase7.mjs",
    "verify:v03-phase1": "node scripts/verify-v03-phase1.mjs",
    "verify:v03-phase2": "node scripts/verify-v03-phase2.mjs",
    "verify:v03-phase3": "node scripts/verify-v03-phase3.mjs",
    "verify:v04-phase4": "node scripts/verify-v04-phase4.mjs",
    "verify:v05-phase5": "node scripts/verify-v05-phase5.mjs",
    "verify:v06-phase6": "node scripts/verify-v06-phase6.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nampluskr/workbench-kit.git"
  },
  "keywords": [],
  "author": "workbench-kit contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "electron": "^44.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dockview-core": "^8.2.0",
    "monaco-editor": "0.56.0",
    "node-pty": "^1.1.0"
  }
